# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.

# Supabase → Project Settings → Data API (URL) and API Keys (publishable / anon key).
# These two are safe for the browser: access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public base URL used inside QR codes. Use your deployed URL (or LAN IP) so phones can open it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
